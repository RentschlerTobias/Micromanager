{
  "name": "jev-micromanager",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "An OpenCode v2 plugin that orchestrates sub-agents, with TypeSafe Jev making the decisions",
  "scripts": {
    "test": "XDG_STATE_HOME=$(mktemp -d) node --test 'test/**/*.test.ts'",
    "typecheck": "tsc -p tsconfig.json",
    "eval": "node src/cli.ts eval",
    "export-dataset": "node src/cli.ts export-dataset",
    "bench-guards": "node src/cli.ts bench-guards",
    "bench-n7": "node src/cli.ts bench-n7"
  },
  "devDependencies": {
    "@types/node": "^24.19.0",
    "typescript": "^5.9.3"
  }
}
