# systemd user unit for the decision server. Install:
#   cp decider/jev-decider.service ~/.config/systemd/user/ && systemctl --user enable --now jev-decider
# Set --model to a fine-tuned checkpoint directory once one exists.
[Unit]
Description=micromanager GLiNER2 decision server (CPU)

[Service]
Environment=CUDA_VISIBLE_DEVICES=
WorkingDirectory=%h/Fun/Projects/Repos/micromanager/decider
ExecStart=/usr/bin/uv run --frozen jev-decider --port 8781 --model fastino/GLiNER2.5-multi-Decide --threads 8
Restart=on-failure

[Install]
WantedBy=default.target
